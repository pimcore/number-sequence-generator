{
    "name": "pimcore/number-sequence-generator",
    "license": "proprietary",
    "type": "pimcore-bundle",
    "description": "Pimcore Number Sequence Generator",
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "require": {
      "php": "~8.4.0 || ~8.5.0",
      "pimcore/pimcore": "^2026.1"
    },
    "require-dev": {
      "phpstan/phpstan": "^1.12.15"
    },
    "autoload": {
        "psr-4": {
            "Pimcore\\Bundle\\NumberSequenceGeneratorBundle\\": "src/"
        }
    },
    "extra": {
        "pimcore": {
            "bundles": [
                "Pimcore\\Bundle\\NumberSequenceGeneratorBundle\\NumberSequenceGeneratorBundle"
            ]
        }
    }
}
